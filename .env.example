# Todas as variáveis abaixo são opcionais - sem elas o ECHO sobe normalmente, mas
# `GET /status` reporta "provedor_configurado: false" e o Radar Musical fica vazio
# (nunca inventa lançamento/música pra preencher).

# Chave da API do Last.fm - gratuita, sem cartão, sem login de usuário (só dado
# público: busca, chart global, gênero por artista). Crie uma conta grátis em
# last.fm/join (se ainda não tiver) e gere a chave em last.fm/api/account/create
# (qualquer nome de aplicação/descrição de contato serve). Cole só o "API key" -
# não precisa do "Shared secret" (esse é só pra métodos com login de usuário,
# fora do escopo desta Fase 1).
LASTFM_API_KEY=

# Username do Last.fm (opcional) - só necessário se você já usa scrobbling
# (Spotify/outro player -> Last.fm, ver last.fm/about/trackmymusic) e quer que o
# ECHO use seu histórico REAL de escuta pra montar o perfil musical (artistas
# favoritos, peso de gênero), em vez de só cadastro manual. É o nome que aparece
# em last.fm/user/<username> - PÚBLICO, não é senha nem chave, só identifica de
# quem buscar o histórico. Sem ele, os métodos que dependem de histórico
# (obter_top_artistas_usuario/obter_top_faixas_usuario/
# obter_reproduzidas_recentemente) ficam indisponíveis, mas o resto do ECHO
# funciona normalmente.
LASTFM_USERNAME=
